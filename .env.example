# Referencia de configuración SIN credenciales.
# VOXBOARD no carga .env automáticamente. Asignar las variables en PowerShell
# antes de arrancar (ver README); no agregar python-dotenv por este archivo.
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_TIMEOUT=120
# Completar solo cuando exista una URL pública real del centro de recursos.
VOXBOARD_HELP_URL=
# DATABASE, VOSK_MODEL_PATH y SECRET_KEY NO se leen del entorno.
# La clave se genera localmente junto a SQLite; nunca publicarla.
